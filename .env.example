# =============================================
# Upstash Redis — 필수 (v1.7+)
# =============================================
# 데스크탑·모바일 간 갤러리 동기화를 위해 필요합니다.
#
# Vercel Marketplace에서 "Upstash"를 Add Integration 하면
# 아래 2개 변수가 프로젝트에 자동 주입됩니다. 수동 설정은 불필요.
#
# 설정 가이드: README.md § "Upstash Redis 연결" 참조
# =============================================

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================
# 하위 호환 — 구 Vercel KV 환경변수
# =============================================
# 2024년 이전에 Vercel KV를 쓰던 프로젝트는 아래 변수도 자동 인식됩니다.
# 신규 설정이라면 위의 UPSTASH_REDIS_REST_* 만 쓰면 됩니다.
# =============================================
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# =============================================
# 선택 — 관리자 비밀번호
# =============================================
# 기본값: "1718" (17기 + 18기)
# 보안 강화를 원하면 아래 환경변수로 재정의하세요.
# =============================================
# ADMIN_PASSWORD="your-stronger-password"

# =============================================
# 선택 — 사이트 기본 URL
# =============================================
# JSON-LD, sitemap, canonical, OG 이미지의 절대 경로 생성에 사용.
# =============================================
# NEXT_PUBLIC_SITE_URL="https://nest-alum1.vercel.app"
